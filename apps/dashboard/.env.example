# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/duster

# Auth
JWT_SECRET=your-jwt-secret-min-32-chars-change-in-production

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_duster_standard_monthly

# AWS (for EC2 provisioning)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DUSTER_AMI_ID=ami-xxxxxxxxx
PRIVATE_SUBNET_ID=subnet-xxxxxxxxx
TENANT_SECURITY_GROUP_ID=sg-xxxxxxxxx
TENANT_INSTANCE_PROFILE=duster-production-tenant-profile

# Email (SMTP)
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Duster <noreply@duster.ai>

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
