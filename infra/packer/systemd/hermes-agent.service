[Unit]
Description=Hermes AI Agent
After=ollama.service
Requires=ollama.service

[Service]
Type=simple
User=duster
WorkingDirectory=/opt/duster
ExecStartPre=/bin/bash -c 'until curl -sf http://127.0.0.1:11434/api/tags; do sleep 2; done'
ExecStart=/usr/local/bin/hermes gateway run
Restart=always
RestartSec=5
Environment="NODE_ENV=production"
Environment="OLLAMA_HOST=http://127.0.0.1:11434"
Environment="API_SERVER_HOST=0.0.0.0"
Environment="API_SERVER_PORT=8080"
Environment="API_SERVER_ENABLED=true"
Environment="HERMES_PROFILE=duster"
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
